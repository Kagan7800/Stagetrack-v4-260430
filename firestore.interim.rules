rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Classroom & Synchronization paths: Require authentication (including anonymous)
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /lobbyPresence/{sessionId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /joinRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // 2. Live Occupancy: Client read-only, writes exclusively via Cloud Functions
    match /occupancy/{passId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 3. Internal / Sensitive Collections: Completely closed to client SDKs
    match /guestPasses/{passId} {
      allow read, write: if false;
    }
    match /joinTokens/{tokenId} {
      allow read, write: if false;
    }
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
    match /deliveryQueue/{deliveryId} {
      allow read, write: if false;
    }
    match /agentLogs/{logId} {
      allow read, write: if false;
    }
  }
}
