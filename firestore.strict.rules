rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isInstructor() {
      return isSignedIn() && (request.auth.token.instructor == true || isAdmin());
    }

    function isGuest() {
      return isSignedIn() && ('isGuest' in request.auth.token) && request.auth.token.isGuest == true;
    }

    function isGuestPassActive() {
      let passDoc = get(/databases/$(database)/documents/guestPasses/$(request.auth.token.passId));
      return passDoc != null &&
             passDoc.data.status == 'active' &&
             (!('revokedAt' in passDoc.data) || request.auth.token.auth_time * 1000 > passDoc.data.revokedAt.toMillis());
    }

    function isPassOwner(passId) {
      return isSignedIn() && request.auth.token.passId == passId && (!isGuest() || isGuestPassActive());
    }

    function hasProgramAccess(programId) {
      return isInstructor() || (isSignedIn() && request.auth.token.programId == programId && (!isGuest() || isGuestPassActive()));
    }

    function isSessionActiveForJoin(sessionId) {
      let sessionDoc = get(/databases/$(database)/documents/sessions/$(sessionId));
      return sessionDoc != null &&
             sessionDoc.data.programId == request.auth.token.programId &&
             (sessionDoc.data.state == 'lobby_open' || sessionDoc.data.state == 'live');
    }

    // --- 1. Guest Passes ---
    // Zero client reads or writes. All pass reads/writes go through sanitized server functions (┬º7).
    match /guestPasses/{passId} {
      allow read, write: if false;
    }

    // --- 2. Sessions ---
    // Read: only active program members or instructors. Write: instructors only.
    match /sessions/{sessionId} {
      allow read: if hasProgramAccess(resource.data.programId);
      allow write: if isInstructor();
    }

    // --- 3. Join Requests ---
    // Create: authenticated active pass holder can ONLY create 'pending' requests for active sessions.
    // Read: instructor can read all in program; active pass owner can only read their own request.
    // Update/Delete: instructor only (parents CANNOT self-admit or change status).
    match /joinRequests/{requestId} {
      allow create: if isSignedIn() &&
                    request.resource.data.passId == request.auth.token.passId &&
                    request.resource.data.status == 'pending' &&
                    (!isGuest() || isGuestPassActive()) &&
                    isSessionActiveForJoin(request.resource.data.sessionId);
      allow read: if isInstructor() || (isSignedIn() && resource.data.passId == request.auth.token.passId && (!isGuest() || isGuestPassActive()));
      allow update: if isInstructor();
      allow delete: if isInstructor();
    }

    // --- 4. Live Occupancy ---
    // Server-write only via Cloud Functions. Read by instructors or the active pass owner (┬º5 Task 6 & Task 8).
    match /occupancy/{passId} {
      allow read: if isInstructor() || (isSignedIn() && request.auth.token.passId == passId && (!isGuest() || isGuestPassActive()));
      allow write: if false;
    }

    // --- 5. Lobby Presence (Count Only) ---
    // Active parents can write their own presence heartbeat doc. Instructors can read/count.
    match /lobbyPresence/{sessionId}/active/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid && (!isGuest() || isGuestPassActive());
      allow read: if isInstructor();
    }

    // --- 6. Internal Collections ---
    // Rate limits, join tokens, agent logs, and internal credentials are strictly server-managed.
    match /joinTokens/{tokenId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /agentLogs/{logId} {
      allow read, write: if false;
    }

    match /deliveryQueue/{deliveryId} {
      allow read, write: if false;
    }
  }
}
